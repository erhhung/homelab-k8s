---
apiVersion: pyrra.dev/v1alpha1
kind: ServiceLevelObjective
metadata:
  name: openclaw-message-completion
  # required by Thanos Ruler k8s-sidecar!
  labels: {{ pyrra_rule_selector_labels }}
spec:
  description: 99.9% of messages finish processing
  indicator:
    ratio:
      errors:
        metric: openclaw_message_processed_total{exported_job="openclaw-gateway",openclaw_outcome="error"}
      total:
        metric: openclaw_message_processed_total{exported_job="openclaw-gateway",openclaw_outcome=~"completed|error"}
  # https://doc.crds.dev/github.com/pyrra-dev/pyrra/pyrra.dev/ServiceLevelObjective/v1alpha1#spec-partial_response_strategy
  partial_response_strategy: abort # abort|warn
  target: "99.9"
  window: 2w
