# IMPORTANT! all variable assignments must be on one line

# shellcheck disable=SC2148 # Tips depend on target shell
# shellcheck disable=SC2034 # The variable appears unused

umask 0022

# this has been superseded by Oh My Posh themed prompt
# PS1="\[\033[1;36m\]$USER\[\033[1;31m\]@\[\033[1;32m\]\h:\[\033[1;35m\]\w\[\033[1;31m\]$\[\033[0m\] "

# only works once VSCode remote SSH server
# is dynamically installed upon connection
EDITOR="code --wait"
VISUAL="$EDITOR"

LESS="-RFKMi -x4 -z-4"
LESS_ADVANCED_PREPROCESSOR=1
# LESSOPEN="|-$HOME/.lessopen %s"
# LESSCOLORIZER=pygmentize
LESSCHARSET=utf-8
LESSQUIET=1

DELTA_PAGER="less -RFKLMin"
BAT_PAGER="less -RFKLMin"
BAT_THEME="Visual Studio Dark+"
BAT_STYLE=grid,numbers

GREP_OPTIONS="--color=auto"
# load .env in any dir:
# https://mise.jdx.dev/environments#env-file
MISE_ENV_FILE=.env

# https://github.com/junegunn/fzf#environment-variables
FZF_DEFAULT_OPTS="--multi --pointer=▶ --marker=• --height=33% --layout=reverse --border=rounded --info=inline-right --color=prompt:bright-cyan:bold,header:bright-green,pointer:bright-red:bold,marker:yellow:bold"
# https://github.com/junegunn/fzf#key-bindings-for-command-line
FZF_CTRL_R_OPTS="--header 'Ctrl-/ to toggle PREVIEW' --preview 'echo {}' --preview-window up:3:hidden:wrap --bind 'ctrl-/:toggle-preview'"
# https://github.com/lincheney/fzf-tab-completion#autocomplete-common-prefix
FZF_COMPLETION_AUTO_COMMON_PREFIX=true
FZF_COMPLETION_AUTO_COMMON_PREFIX_PART=true

# https://github.com/ajeetdsouza/zoxide#environment-variables
_ZO_DATA_DIR="$XDG_DATA_HOME/zoxide"

# secret key from Secret-mounted volume
AGE_KEY_FILE=/run/secrets/AGE_SECRET_KEY
GPG_TTY="$(tty)"

# $XDG_CACHE_HOME is on different filesystem than /workspace,
# so suppress warning about failing to create hardlink files
UV_LINK_MODE=copy

# https://kubecolor.github.io/reference/environment-variables
KUBECOLOR_OBJ_FRESH=1h

# the following variables are explicitly relayed by
# `pam_env.so` from envFrom Secret in dev container
# CI_REGISTRY_PASSWORD
# DOCKER_ACCESS_TOKEN
# GITHUB_ACCESS_TOKEN
# SMTP_PASSWORD

CI_REGISTRY=https://harbor.fourteeners.local
CI_REGISTRY_PATH=harbor.fourteeners.local/library
CI_REGISTRY_USER=erhhung
DOCKER_USER=erhhung
GITHUB_USER=erhhung
SMTP_USER=mailer
SMTP_HOST=smtp.fourteeners.local
SMTP_PORT=587
